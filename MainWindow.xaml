<Window x:Class="ADWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADWpfApp"
        mc:Ignorable="d"
        Title="AD 驗證測試工具" Height="400" Width="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Width="100" VerticalAlignment="Center" FontSize="18">帳號：</TextBlock>
            <TextBox x:Name="txtUsername" Width="300" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,5" Grid.Row="1">
            <TextBlock Width="100" VerticalAlignment="Center" FontSize="18">密碼：</TextBlock>
            <PasswordBox x:Name="txtPassword" Width="300" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,5" Grid.Row="2">
            <TextBlock Width="100" VerticalAlignment="Center" FontSize="18">伺服器：</TextBlock>
            <TextBox x:Name="txtServer" Width="300" Text="ldap.yourdomain.local" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,5" Grid.Row="3">
            <TextBlock Width="100" VerticalAlignment="Center" FontSize="18">連接埠：</TextBlock>
            <TextBox x:Name="txtPort" Width="300" Text="389" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,5" Grid.Row="4">
            <TextBlock Width="100"></TextBlock>
            <CheckBox x:Name="chkLDAPS" Content="使用 LDAPS (SSL)" Checked="chkLDAPS_Checked" Unchecked="chkLDAPS_Unchecked" FontSize="18" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10" Grid.Row="5">
            <TextBlock Width="100"></TextBlock>
            <Button x:Name="btnTest" Content="測試驗證" Width="120" Click="btnTest_Click" FontSize="18" />
        </StackPanel>

        <TextBox x:Name="txtResult" Grid.Row="6" Margin="0,10" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" />
    </Grid>
</Window>